# Plantilla local: copia a .env y completa credenciales/rutas reales.
# No pongas secretos en Git. run-local.ps1 carga este archivo para el proceso Maven.

# PostgreSQL compartido con Auth y Query. DB_URL debe comenzar con postgresql://.
DB_URL=postgresql://localhost:5432/db_scoring
DB_USERNAME=scoring_app
DB_PASSWORD=CHANGE_ME
SCORING_FLYWAY_MIGRAR_AL_ARRANCAR=false

# JWT de usuario firmado por auth-api. Solo se configura la clave pública.
AUTH_JWT_ISSUER=crediticio-auth
SCORING_JWT_PUBLIC_KEY_LOCATION=file:../auth/keys/jwt-publica.pem

# CORS del frontend.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Saga de recomendaciones Scoring -> Query. Deshabilitada por defecto.
# Para el flujo integrado, activa true en Scoring y Query y completa el mismo kid/par de servicio.
SCORING_SAGA_HABILITADA=false
EVALUATION_QUERY_API_BASE_URL=http://localhost:8082
SCORING_SERVICE_JWT_ISSUER=scoring-api
SCORING_SERVICE_JWT_KEY_ID=local-scoring-service-v1
SCORING_SERVICE_JWT_PRIVATE_KEY_LOCATION=file:./keys-service/scoring-service-private.pem
SCORING_SERVICE_JWT_PUBLIC_KEY_LOCATION=file:./keys-service/scoring-service-public.pem
# Solo durante migraciones controladas, con el procedimiento documentado; no usar para arranques diarios.
# SPRING_FLYWAY_USER=
# SPRING_FLYWAY_PASSWORD=
